Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
      Splitter Ratio: 0.5
    Tree Height: 600
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 160
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Description Topic:
        Value: /robot_description
      Alpha: 1
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Topic:
        Depth: 5
        Reliability Policy: Best Effort
        Value: /scan
      Size (Pixels): 3
      Style: Points
      Color: 255; 25; 0
    - Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Depth: 1
        Reliability Policy: Reliable
        Value: /map
      Alpha: 0.85
      Color Scheme: map
      Draw Behind: false
      Update Topic:
        Value: /map_updates
    - Class: rviz_default_plugins/Path
      Name: RobotPath
      Topic:
        Value: /slam_toolbox/graph_visualization
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Value: true
Views:
  Current:
    Class: rviz_default_plugins/TopDownOrtho
    Name: TopDown
    X: 0
    Y: 0
    Angle: 0
    Scale: 80
    Target Frame: base_footprint
Window Geometry:
  Height: 800
  Width: 1200
  X: 50
  Y: 50
